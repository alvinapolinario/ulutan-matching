# All settings are optional. Set them in your shell or service manager.
PORT=3080
# HOST=0.0.0.0   (default: all addresses)
# Where db.json, sessions.json and backups/ are stored
DATA_DIR=./data
# Only set to true if you put the app behind HTTPS
SECURE_COOKIES=false
# Set true when nginx (or similar) is the only client, so logins are limited per visitor
# TRUST_PROXY=true
# Optional fixed session secret (otherwise one is generated in data/session-secret.txt)
# SESSION_SECRET=change-me
