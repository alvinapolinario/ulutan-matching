<%- include('partials/head') %>
<div class="d-flex align-items-center mb-3 gap-2 flex-wrap">
  <h1 class="page-title"><i class="bi bi-feather" aria-hidden="true"></i>Gamecocks</h1>
  <span id="liveDot" class="live-dot" title="Connecting…"></span>
  <div class="ms-auto d-flex gap-2 flex-wrap">
    <a class="btn btn-sm btn-outline-dark" href="/reports/gamecocks" target="_blank"><i class="bi bi-printer" aria-hidden="true"></i> Print</a>
    <a class="btn btn-sm btn-outline-dark" href="/reports/gamecocks?format=csv"><i class="bi bi-filetype-csv" aria-hidden="true"></i> Export CSV</a>
  </div>
</div>
<div class="d-flex flex-wrap gap-2 mb-3" id="chips" role="group" aria-label="Filter by status"></div>
<div class="card">
  <div class="card-header bg-white d-flex flex-wrap gap-2 align-items-center">
    <div class="input-group input-group-sm" style="max-width:300px">
      <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
      <input class="form-control" id="search" placeholder="Search legband, entry name, owner or fight no." aria-label="Search gamecocks">
    </div>
    <select class="form-select form-select-sm" style="max-width:190px" id="sortBy" aria-label="Sort">
      <option value="entry" selected>Sort by entry #</option>
      <option value="legband">Sort by legband</option>
      <option value="owner">Sort by owner</option>
      <option value="fight">Sort by fight no.</option>
    </select>
    <span class="small text-muted ms-auto" id="counts"></span>
  </div>
  <div class="table-responsive" style="max-height:75vh">
    <table class="table table-bordered align-middle mb-0 gc-table">
      <thead class="sticky-top"><tr>
        <th style="width:110px">Entry #</th>
        <th>Entry Name/Owner</th>
        <th style="width:130px">Legband</th>
        <th style="width:130px">Status</th>
        <th style="width:120px">Fight</th>
        <th style="width:180px">Opponent</th>
      </tr></thead>
      <tbody id="gcRows"><tr><td colspan="6" class="text-muted">Loading…</td></tr></tbody>
    </table>
  </div>
</div>
<%- include('partials/foot', { scripts: ['gamecocks.js'] }) %>
