<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= report.title %> · <%= event.name %></title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.css">
  <link rel="stylesheet" href="/static/css/app.css?v=<%= locals.v || '' %>">
</head>
<body class="bg-white">
<main class="container-fluid py-3">
  <div class="d-flex align-items-start mb-2">
    <div>
      <div class="small text-uppercase text-muted fw-semibold">Tapad-Tapad / Ulutan</div>
      <h1 class="h4 fw-bold mb-0"><%= event.name %></h1>
      <div><%= [event.venue, event.date].filter(Boolean).join(' · ') %></div>
    </div>
    <div class="ms-auto text-end">
      <div class="h5 fw-bold mb-0"><%= report.title %></div>
      <div class="small text-muted">Printed <%= printedAt.toLocaleString('en-PH') %> by <%= user.username %></div>
      <div class="d-print-none mt-2 d-flex gap-2 justify-content-end">
        <button class="btn btn-sm btn-dark" data-print><i class="bi bi-printer" aria-hidden="true"></i> Print</button>
        <a class="btn btn-sm btn-outline-dark" href="?format=csv"><i class="bi bi-filetype-csv" aria-hidden="true"></i> CSV</a>
      </div>
    </div>
  </div>
  <table class="table table-sm table-bordered">
    <thead class="table-light"><tr><% report.columns.forEach(c => { %><th><%= c.label %></th><% }) %></tr></thead>
    <tbody>
      <% if (!report.rows.length) { %><tr><td colspan="<%= report.columns.length %>" class="text-muted">No records.</td></tr><% } %>
      <% report.rows.forEach(r => { %><tr><% report.columns.forEach(c => { %><td class="<%= c.legband ? 'lb' : '' %>"><%= r[c.key] %></td><% }) %></tr><% }) %>
    </tbody>
  </table>
  <div class="small text-muted"><%= report.rows.length %> row(s)</div>
</main>
<script src="/static/js/print.js?v=<%= locals.v || '' %>"></script>
</body>
</html>
