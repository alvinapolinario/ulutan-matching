<%- include('partials/head') %>
<div class="d-flex align-items-center mb-3 gap-2 flex-wrap">
  <h1 class="page-title"><i class="bi bi-person-plus" aria-hidden="true"></i>Registration</h1>
  <span id="liveDot" class="live-dot" title="Connecting…"></span>
  <div class="ms-auto d-flex gap-3 small text-muted" id="totals"></div>
</div>
<div class="row g-3">
  <div class="col-xl-4 col-lg-5">
    <form class="card p-3 reg-form" id="regForm" autocomplete="off" novalidate>
      <h2 class="h6 fw-bold mb-3"><i class="bi bi-pencil-square" aria-hidden="true"></i> New entry</h2>
      <div class="alert alert-danger py-2 d-none" id="regError" role="alert"></div>
      <label class="form-label" for="participantName">Participant (owner) name</label>
      <input class="form-control mb-1" id="participantName" name="participantName" list="participantList" maxlength="100" required>
      <datalist id="participantList"></datalist>
      <div class="form-text mb-2">Same name = same owner. Pick an existing name to add another entry for that owner.</div>
      <label class="form-label" for="entryName">Entry name</label>
      <input class="form-control mb-2" id="entryName" name="entryName" maxlength="100" placeholder="Leave blank to use the owner's name">
      <label class="form-label" for="address">Address</label>
      <input class="form-control mb-1" id="address" name="address" maxlength="120" placeholder="e.g. Brgy. Poblacion, Iligan City" list="addressList">
      <datalist id="addressList"></datalist>
      <% const manualLb = (event.legbandMode || 'MANUAL') === 'MANUAL'; %>
      <% const perEntry = event.cocksPerEntry || 2; %>
      <% const derby = event.eventType === 'DERBY'; const rules = weightRules(event); const byWeight = !!rules; %>
      <% const types = allowedTypes(event); const typeLabel = { COCK: 'Cock', STAG: 'Stag', BULLSTAG: 'Bullstag' }; %>
      <% const withWing = types.includes('STAG') || types.includes('BULLSTAG'); const withCock = types.includes('COCK'); %>
      <% const range = rules && (rules.min != null || rules.max != null) ? `${rules.min != null ? rules.min : '…'}–${rules.max != null ? rules.max : '…'}` : ''; %>
      <% const typeOptions = types.map((t) => `<option value="${t}">${typeLabel[t]}</option>`).join(''); %>
      <% const bandWord = 'Legband'; %>
      <div class="form-text mb-2">Shown under the entry name on the TV.</div>
      <%# One row per bird: [type] [legband (typed mode; may be added later)] [wingband: stag / bullstag] [weight: cock] %>
      <div class="bird-rows mb-1" id="birdRows">
        <div class="row g-1 small text-muted fw-semibold">
          <div class="col-1">#</div>
          <div class="col-3">Type of bird</div>
          <% if (manualLb) { %><div class="col">Legband</div><% } %>
          <% if (withWing) { %><div class="col">Wingband</div><% } %>
          <div class="col">Weight (g)</div>
        </div>
        <% for (let i = 1; i <= perEntry; i++) { %>
        <div class="row g-1 align-items-center bird-row" data-slot="<%= i %>">
          <div class="col-1 fw-semibold"><%= i %></div>
          <div class="col-3"><select class="form-select form-select-sm bird-type" id="type<%= i %>" name="type<%= i %>" data-slot="<%= i %>" aria-label="Bird <%= i %> type"><%- typeOptions %></select></div>
          <% if (manualLb) { %>
          <div class="col"><input class="form-control form-control-sm lb-input" id="legband<%= i %>" name="legband<%= i %>" data-slot="<%= i %>" inputmode="numeric" maxlength="6" autocomplete="off" placeholder="later OK" aria-label="Legband <%= i %>" aria-describedby="lb<%= i %>Info"></div>
          <% } %>
          <% if (withWing) { %>
          <div class="col"><input class="form-control form-control-sm bird-wing" id="wingband<%= i %>" name="wingband<%= i %>" data-slot="<%= i %>" inputmode="numeric" maxlength="6" autocomplete="off" placeholder="—" disabled aria-label="Bird <%= i %> wingband"></div>
          <% } %>
          <div class="col"><input class="form-control form-control-sm bird-weight" id="weight<%= i %>" name="weight<%= i %>" data-slot="<%= i %>" inputmode="decimal" maxlength="8" autocomplete="off" placeholder="<%= byWeight ? (range || 'required') : 'grams' %>" aria-label="Bird <%= i %> weight in grams"></div>
          <div class="col-12 small lb-info" id="lb<%= i %>Info"></div>
        </div>
        <% } %>
      </div>
      <div class="form-text mb-<%= manualLb ? 3 : 2 %>">
        <b><%= derby ? 'Derby' : 'Hackfight' %></b> · <%= perEntry %> birds per entry · allowed: <b><%= types.map((t) => typeLabel[t]).join(', ') %></b>.
        <% if (withCock) { %><b>Cock</b>: weight<%= byWeight ? ` required${range ? ` (${range} g)` : ''}, matched within ±${rules.tolerance} g` : ' optional (no weight rules)' %>; no wingband.<% } %>
        <% if (withWing) { %><b><%= types.filter((t) => t !== 'COCK').map((t) => typeLabel[t]).join(' / ') %></b>: wingband required.<% } %>
        <% if (manualLb) { %>The legband can be typed now or added later with <b>+ Legband</b>.<% } %>
        <kbd>Enter</kbd> moves to the next box; on the last box it saves. Fewer birds now? <kbd>Enter</kbd> twice on the next bird saves. <kbd>Ctrl</kbd>+<kbd>Enter</kbd> saves at any time.
      </div>
      <% if (!manualLb) { %>
      <label class="form-label" for="legbandCount">Birds to register now</label>
      <select class="form-select mb-3" id="legbandCount" name="legbandCount">
        <option value="<%= perEntry %>"><%= perEntry %> — complete entry</option>
        <% for (let i = perEntry - 1; i >= 1; i--) { %>
        <option value="<%= i %>"><%= i %> — incomplete, add the rest later</option>
        <% } %>
      </select>
      <div class="d-flex align-items-center justify-content-between bg-light rounded p-2 mb-3">
        <span class="text-muted small">Next legband number(s)</span>
        <span class="next-lb lb" id="nextLb">—</span>
      </div>
      <% } %>
      <button class="btn btn-dark btn-lg" type="submit" id="regSubmit"><i class="bi bi-check2" aria-hidden="true"></i> Save entry</button>
    </form>
    <div class="card p-3 mt-3 d-none" id="lastSaved" aria-live="polite"></div>
  </div>
  <div class="col-xl-8 col-lg-7">
    <div class="card">
      <div class="card-header bg-white d-flex flex-wrap gap-2 align-items-center">
        <div class="input-group input-group-sm" style="max-width:260px">
          <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
          <input class="form-control" id="search" placeholder="Search name, entry no. or legband" aria-label="Search entries">
        </div>
        <select class="form-select form-select-sm" style="max-width:160px" id="statusFilter" aria-label="Filter by status">
          <option value="">All statuses</option><option>COMPLETE</option><option>INCOMPLETE</option><option>WITHDRAWN</option>
        </select>
        <div class="ms-auto d-flex gap-2">
          <a class="btn btn-sm btn-outline-dark" href="/reports/registration" target="_blank"><i class="bi bi-printer" aria-hidden="true"></i> Print</a>
          <a class="btn btn-sm btn-outline-dark" href="/reports/registration?format=csv"><i class="bi bi-filetype-csv" aria-hidden="true"></i> Export CSV</a>
        </div>
      </div>
      <div class="table-responsive" style="max-height:70vh">
        <table class="table table-sm table-hover mb-0">
          <thead class="sticky-top bg-white"><tr><th>Entry No.</th><th>Entry Name</th><th>Participant</th><% for (let i = 1; i <= perEntry; i++) { %><th>Bird <%= i %></th><% } %><th>Status</th><th class="text-end">Actions</th></tr></thead>
          <tbody id="entryRows"><tr><td colspan="<%= 5 + perEntry %>" class="text-muted">Loading…</td></tr></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editTitle" aria-modal="true" role="dialog">
  <div class="modal-dialog"><form class="modal-content" id="editForm" novalidate autocomplete="off">
    <div class="modal-header"><h5 class="modal-title" id="editTitle">Edit entry</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
    <div class="modal-body">
      <div class="alert alert-danger py-2 d-none" id="editError" role="alert"></div>
      <div class="alert alert-warning py-2 d-none" id="editLocked">This entry already has an official match. The change is recorded in the audit trail.</div>
      <input type="hidden" name="entryId">
      <label class="form-label">Participant (owner) name</label><input class="form-control mb-2" name="participantName" list="participantList" required>
      <label class="form-label">Entry name</label><input class="form-control mb-2" name="entryName" required>
      <label class="form-label">Address</label><input class="form-control mb-2" name="address" maxlength="120">
      <div class="row g-2 mb-2">
        <% for (let i = 1; i <= perEntry; i++) { %>
        <div class="col-12 d-flex gap-2 align-items-center">
          <span class="fw-semibold" style="width:1.5rem"><%= i %></span>
          <%# All three types are listed so a bird of a type no longer allowed still shows; changing to one is refused. %>
          <select class="form-select form-select-sm edit-type" name="type<%= i %>" data-slot="<%= i %>" style="max-width:7.5rem" aria-label="Bird <%= i %> type"><% ['COCK', 'STAG', 'BULLSTAG'].forEach((t) => { %><option value="<%= t %>" <%= types.includes(t) ? '' : 'disabled' %>><%= typeLabel[t] %></option><% }) %></select>
          <input class="form-control form-control-sm lb" name="legband<%= i %>" inputmode="numeric" maxlength="6" placeholder="Legband" aria-label="Legband <%= i %>">
          <input class="form-control form-control-sm <%= withWing ? '' : 'd-none' %>" name="wingband<%= i %>" inputmode="numeric" maxlength="6" placeholder="Wingband" aria-label="Bird <%= i %> wingband">
          <input class="form-control form-control-sm" name="weight<%= i %>" inputmode="decimal" maxlength="8" placeholder="grams" style="max-width:6.5rem" aria-label="Bird <%= i %> weight">
        </div>
        <% } %>
      </div>
      <div id="reasonWrap" class="d-none"><label class="form-label">Reason for correction</label><input class="form-control" name="reason"></div>
      <p class="small text-muted mt-2 mb-0" id="editLegbands">A bird's type, band number and weight can be corrected until it is used in a match.</p>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-dark" type="submit">Save</button></div>
  </form></div>
</div>
<%- include('partials/foot', { scripts: ['registration.js'] }) %>
