<%- include('partials/head') %>
<div class="d-flex align-items-center mb-3 gap-2">
  <h1 class="page-title"><i class="bi bi-speedometer2" aria-hidden="true"></i><%= event.name %></h1>
  <span id="liveDot" class="live-dot" title="Connecting…"></span>
  <span class="text-muted ms-2"><i class="bi bi-geo-alt" aria-hidden="true"></i> <%= [event.venue, event.date].filter(Boolean).join(' · ') %></span>
</div>
<div class="row g-3 mb-3" id="stats"></div>
<div class="row g-3">
  <div class="col-md-4"><a class="shortcut" href="/registration"><span class="shortcut-icon reg"><i class="bi bi-person-plus" aria-hidden="true"></i></span><span><span class="fw-bold d-block">Registration</span><span class="small text-muted"><%= (event.legbandMode || 'MANUAL') === 'MANUAL' ? 'Add entries and type the legband numbers from management.' : 'Add entries. Legband numbers are issued automatically.' %></span></span></a></div>
  <div class="col-md-4"><a class="shortcut" href="/matching"><span class="shortcut-icon match"><i class="bi bi-arrow-left-right" aria-hidden="true"></i></span><span><span class="fw-bold d-block">Matching</span><span class="small text-muted">Type Red and Blue legbands, check, then confirm.</span></span></a></div>
  <div class="col-md-4"><a class="shortcut" href="/display-control"><span class="shortcut-icon tv"><i class="bi bi-tv" aria-hidden="true"></i></span><span><span class="fw-bold d-block">TV Control</span><span class="small text-muted">Current fight, results, and the next fight.</span></span></a></div>
</div>
<%- include('partials/foot', { scripts: ['dashboard.js'] }) %>
